#!/bin/bash
${common_bootstrap}

# 관측 설정은 Git 이 유일한 출처다 (INF-32).
# 임계값은 부하 시험 후 여러 번 고칠 값이라 Terraform 에 넣지 않는다.
# 고친 뒤에는 이 인스턴스에서 git pull 하고 reload 한다 (OPS-2-18).
GITHUB_TOKEN=$(aws ssm get-parameter --name "/${project}/github-token" --region ${region} --with-decryption --query 'Parameter.Value' --output text)
DB_ENDPOINT=$(aws ssm get-parameter --name "/${project}/db-endpoint" --region ${region} --query 'Parameter.Value' --output text)
CACHE_ENDPOINT=$(aws ssm get-parameter --name "/${project}/cache-endpoint" --region ${region} --query 'Parameter.Value' --output text)
DB_EXPORTER_PASSWORD=$(aws ssm get-parameter --name "/${project}/db-exporter-password" --region ${region} --with-decryption --query 'Parameter.Value' --output text)

# 웹훅 URL 은 사실상 자격증명이다. 파일로 떨어뜨려 Alertmanager 가 읽게 한다.
install -d -m 0700 /run/secrets
for name in critical warning watchdog; do
  aws ssm get-parameter --name "/${project}/slack-webhook-$name" --region ${region} \
    --with-decryption --query 'Parameter.Value' --output text > "/run/secrets/slack_webhook_$name"
  chmod 600 "/run/secrets/slack_webhook_$name"
done

install -d -m 0755 /opt/${project}
git clone --depth 1 "https://x-access-token:$GITHUB_TOKEN@github.com/${github_org}/${infra_repo}.git" /opt/${project}/infra
cd /opt/${project}/infra/observability

cat > .env <<ENV
DB_ENDPOINT=$DB_ENDPOINT
CACHE_ENDPOINT=$CACHE_ENDPOINT
DB_EXPORTER_PASSWORD=$DB_EXPORTER_PASSWORD
ENV
chmod 600 .env

cat > /etc/systemd/system/observability.service <<'UNIT'
[Unit]
Description=observability stack
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/${project}/infra/observability
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now observability.service
