#!/bin/bash
#
# SSM 에서 값을 읽어 .env 를 통째로 다시 만든다.
#
# 최초 부팅과 재배포가 같은 코드를 쓴다.
# 부분 수정(GIT_SHA 만 sed)을 하면 나머지 값이 부팅 시점에 고정되어,
# RDS 복원으로 엔드포인트가 바뀌어도 배치가 따라가지 못한다 (INF-26).
set -euo pipefail

P=/${project}
R=${region}
get() { aws ssm get-parameter --name "$P/$1" --region "$R" --query 'Parameter.Value' --output text; }
sec() { aws ssm get-parameter --name "$P/$1" --region "$R" --with-decryption --query 'Parameter.Value' --output text; }

GIT_SHA=$(get current-sha)
DB_ENDPOINT=$(get db-endpoint)
CACHE_ENDPOINT=$(get cache-endpoint)
LOKI_ENDPOINT=$(get loki-endpoint)
DB_PASSWORD=$(sec db-password)
GHCR_TOKEN=$(sec ghcr-token)

TOKEN=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')
INSTANCE_ID=$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)

# GHCR 패키지는 비공개다. 로그인하지 않으면 pull 이 unauthorized 로 죽는다.
echo "$GHCR_TOKEN" | docker login ghcr.io -u "${github_org}" --password-stdin

install -d -m 0755 /opt/${project}
cat > /opt/${project}/.env <<ENV
GIT_SHA=$GIT_SHA
LOKI_ENDPOINT=$LOKI_ENDPOINT
CACHE_ENDPOINT=$CACHE_ENDPOINT
DB_ENDPOINT=$DB_ENDPOINT
DB_PASSWORD=$DB_PASSWORD
APP_INSTANCE_ID=$INSTANCE_ID
ENV
chmod 600 /opt/${project}/.env
